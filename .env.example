# /etc/garmin-mcp/env (systemd EnvironmentFile). Owner root:garmin-mcp, mode 0640.
# No secrets in this file: secrets live in GCP Secret Manager.

# Public origin Caddy serves (no path). OAuth issuer = this; MCP URL = $PUBLIC_BASE_URL/mcp;
# GitHub callback = $PUBLIC_BASE_URL/github/callback
PUBLIC_BASE_URL=https://garmin.example.com

# Bind address/port for uvicorn. Keep 127.0.0.1: only Caddy talks to the app.
HOST=127.0.0.1
PORT=8000

# Encrypted Garmin tokens live in $DATA_DIR/tokens, OAuth client state in $DATA_DIR/oauth
DATA_DIR=/var/lib/garmin-mcp

# --- GitHub OAuth (identity for claude.ai connector login) -----------------
GITHUB_CLIENT_ID=Ov23li...
# Comma-separated <numeric_github_id>:<user_id>. Numeric ids survive username changes.
# Find yours: gh api users/<login> --jq .id
ALLOWED_GITHUB_USERS=1234567:andrew

# --- Secrets (GCP Secret Manager secret ids) --------------------------------
GCP_PROJECT=my-project
FERNET_KEY_SECRET_NAME=garmin-mcp-fernet-key
GITHUB_CLIENT_SECRET_NAME=garmin-mcp-github-client-secret
# Local dev only: set these instead of using Secret Manager (never on the VM).
ROUTINE_TOKEN_SECRET_NAME=garmin-mcp-routine-token
# GARMIN_MCP_FERNET_KEY=
# GITHUB_CLIENT_SECRET=
# ROUTINE_TOKEN=

# --- Behaviour ---------------------------------------------------------------
# Enable Garmin write methods (uploads/edits/deletes) via execute. Default false.
GARMIN_ALLOW_WRITES=false
# Read your connections' (friends') profiles, activities, stats, PRs and the steps
# leaderboard (get_connections, get_connection_*). Read-only; limited to your own
# connections and what they share with you. Rabbit sets it in /etc/rabbit/env too
# (its coach prompt then gains a training-friends section).
GARMIN_SOCIAL_ENABLED=false
# Use curl_cffi TLS impersonation for Garmin API calls (not just login). Turn on if
# login works but every API call returns 403 from the VM (python-garminconnect#444).
GARMIN_API_TLS_IMPERSONATION=false
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=30
MAX_RESPONSE_BYTES=60000
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
LOG_LEVEL=INFO

# Redirect URIs DCR clients may register (exact match). Default: claude.ai's callback.
OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
# Allow http://localhost:* redirects (MCP Inspector / Claude Code). The GitHub
# allowlist still gates who can finish a login.
OAUTH_ALLOW_LOOPBACK_REDIRECTS=true

# --- Workout-sync poller ------------------------------------------------------
# Polls Garmin for new activities and fires a Claude Code routine once per batch.
# Off unless POLL_USER_ID is set. The routine token comes from ROUTINE_TOKEN_SECRET_NAME.
# POLL_USER_ID=andrew
# ROUTINE_ID=<id from the routine's API trigger at claude.ai/code/routines>
# Log what would be sent instead of firing; the last-seen ID is not saved.
POLL_DRY_RUN=false
# Every POLL_FAST_MINUTES during POLL_FAST_HOURS (local time), on the hour otherwise.
# Rabbit runs this window in each user's own time zone (from their phone); POLL_TIMEZONE is
# the default until the app has reported one.
POLL_TIMEZONE=America/Denver
POLL_FAST_HOURS=5-9
POLL_FAST_MINUTES=5
# Circuit breaker: never fire more than this many times in 24h.
POLL_MAX_FIRES_PER_DAY=10

# --- Rabbit web app (/app) ----------------------------------------------------
# Phone-friendly coach UI with Google sign-in and Web Push. Off unless APP_ENABLED.
# On the VM it runs as its own service (infra/rabbit.env.example, MCP_ENABLED=false),
# so leave these unset in the MCP server's env. Locally you can run both in one process.
# MCP_ENABLED=true
# APP_ENABLED=true
# Google OAuth client (Web application). Redirect URI: $PUBLIC_BASE_URL/app/auth/google/callback
# GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_NAME=garmin-mcp-google-client-secret
# Comma-separated <verified google email>:<user_id>. The Google account's stable id is
# pinned to the user_id on first sign-in.
# ALLOWED_GOOGLE_USERS=you@gmail.com:andrew,friend@gmail.com:friend
APP_SESSION_TTL_SECONDS=7776000
# Web Push: contact URL sent to push services, and the VAPID key secret.
# VAPID_SUBJECT=mailto:you@example.com
VAPID_PRIVATE_KEY_SECRET_NAME=garmin-mcp-vapid-private-key
# Local dev only: GOOGLE_CLIENT_SECRET=  VAPID_PRIVATE_KEY=

# Local dev only: skip OAuth and act as this user. Refused unless PUBLIC_BASE_URL is localhost.
# DEV_NO_AUTH_USER=andrew
