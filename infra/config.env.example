# Copy to infra/config.env (gitignored). Read by infra/setup.sh and deploy.sh.
# Contains no secrets.
PROJECT=my-gcp-project
REGION=us-central1
ZONE=us-central1-a
VM_NAME=garmin-mcp
MACHINE_TYPE=e2-micro
# e2-micro + up to 30GB pd-standard in us-west1/us-central1/us-east1 = GCP always-free tier
DISK_TYPE=pd-standard
DISK_SIZE=30GB
# debian-12 as requested; debian-13 (trixie) is also GA with longer support. uv
# supplies Python 3.12 either way.
IMAGE_FAMILY=debian-12
# true: DNS is a proxied Cloudflare record + Origin CA cert; firewall allows only Cloudflare IPs on 443
BEHIND_CLOUDFLARE=true
DOMAIN=garmin.example.com
GITHUB_CLIENT_ID=Ov23li...
# <numeric_github_id>:<user_id>[,...]   (gh api users/<login> --jq .id)
ALLOWED_GITHUB_USERS=1234567:andrew
