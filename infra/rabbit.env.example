# /etc/rabbit/env (systemd EnvironmentFile for rabbit.service). Owner root:rabbit, mode 0640.
# The Rabbit web app runs as its own process, user, port, data dir and release dir, so
# testing or deploying it never restarts the MCP server. Caddy routes /app* here.
# No secrets in this file: secrets live in GCP Secret Manager.

PUBLIC_BASE_URL=https://garmin.example.com
HOST=127.0.0.1
PORT=8001
DATA_DIR=/var/lib/rabbit
GCP_PROJECT=my-project

# No /mcp endpoint or GitHub OAuth in this process.
MCP_ENABLED=false
APP_ENABLED=true

# Separate Fernet key from the MCP server's: this process can't decrypt its files.
FERNET_KEY_SECRET_NAME=garmin-mcp-rabbit-fernet-key

# Google OAuth client (Web application). Redirect URI: $PUBLIC_BASE_URL/app/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET_NAME=garmin-mcp-google-client-secret
# <verified google email>:<user_id>, comma-separated
ALLOWED_GOOGLE_USERS=
APP_SESSION_TTL_SECONDS=7776000

# Web Push
VAPID_SUBJECT=
VAPID_PRIVATE_KEY_SECRET_NAME=garmin-mcp-vapid-private-key

# Garmin access for Rabbit users (later phases). Tokens live in $DATA_DIR/tokens and are
# owned only by this process: never point two processes at the same user's tokens.
GARMIN_ALLOW_WRITES=false
GARMIN_API_TLS_IMPERSONATION=true
LOG_LEVEL=INFO
